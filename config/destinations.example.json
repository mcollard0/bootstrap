{
  "local_project_backup": {
    "type": "local",
    "enabled": true,
    "destination_dir": "./data",
    "retention_count": 5
  },
  "local_fast_archive": {
    "type": "local",
    "enabled": true,
    "destination_dir": "/run/media/michael/FAST_ARCHIVE/SystemBackups",
    "retention_count": 15
  },
  "aws_s3": {
    "type": "s3",
    "enabled": false,
    "bucket_name": "my-secure-bootstrap-backups",
    "access_key_id": "AKIA...",
    "secret_access_key": "YOUR_SECRET_KEY",
    "region_name": "us-east-1",
    "endpoint_url": null,
    "prefix": "bootstrap-backups/",
    "retention_count": 10
  },
  "cloudflare_r2": {
    "type": "s3",
    "enabled": false,
    "bucket_name": "my-r2-bootstrap-backups",
    "access_key_id": "YOUR_R2_ACCESS_KEY",
    "secret_access_key": "YOUR_R2_SECRET_KEY",
    "region_name": "auto",
    "endpoint_url": "https://<account_id>.r2.cloudflarestorage.com",
    "prefix": "bootstrap-backups/",
    "retention_count": 10
  },
  "google_drive": {
    "type": "gdrive",
    "enabled": false,
    "use_rclone": true,
    "rclone_remote": "gdrive",
    "folder_name": "Bootstrap_Backups",
    "retention_count": 10
  },
  "onedrive": {
    "type": "onedrive",
    "enabled": false,
    "use_rclone": true,
    "rclone_remote": "onedrive",
    "folder_name": "Bootstrap_Backups",
    "retention_count": 10
  },
  "email_smtp": {
    "type": "email",
    "enabled": false,
    "smtp_host": "smtp.gmail.com",
    "smtp_port": 587,
    "use_tls": true,
    "smtp_username": "your.email@gmail.com",
    "smtp_password": "your-app-password",
    "recipient_email": "your.email@gmail.com"
  }
}
